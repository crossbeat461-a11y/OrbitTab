{
  "manifest_version": 3,
  "name": "OrbitTab - パーソナライズ管制塔",
  "version": "1.0.0",
  "description": "お気に入りの背景に、カレンダー・付箋・リンクを自由に配置。ブラウザの『新しいタブ』を、あなただけの効率的な拠点に変えます。",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OrbitTab"
  }
}