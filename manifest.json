{
  "manifest_version": 3,
  "name": "NestTab",
  "version": "1.0.0",
  "description": "Organize your new tab with nested categories and smart history accordions.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "history",
    "topSites",
    "bookmarks",
    "identity"
  ]
}