{
  "manifest_version": 3,
  "name": "NestTab v2",
  "version": "2.0.0",
  "description": "自分専用の機能的なニュータブ・ダッシュボード",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NestTab v2 Settings"
  }
}