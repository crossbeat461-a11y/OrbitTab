{
  "manifest_version": 3,
  "name": "OrbitTab - デジタル管制塔",
  "version": "1.2.0",
  "description": "ブラウザの新しいタブを自分好みのダッシュボードに作り変えます。",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "OrbitTab"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}