{
  "manifest_version": 3,
  "name": "OrbitTab",
  "version": "1.5.4",
  "description": "自分だけのデジタル管制塔。ブックマーク管理、AI連携、付箋機能を搭載。",
  "permissions": ["sidePanel"], 
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "OrbitTab"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}